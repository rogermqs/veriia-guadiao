AGM_PUBLIC_ORIGIN=http://localhost:3000
AGM_API_PORT=3001
AGM_DATA_DIR=data
AGM_BOOTSTRAP_ADMIN_EMAIL=admin@veriia.local
# Defina uma senha longa. O bootstrap gera uma senha local quando .env não existe.
AGM_BOOTSTRAP_ADMIN_PASSWORD=
AGM_LLM_BASE_URL=https://openrouter.ai/api/v1
AGM_LLM_API_KEY=
AGM_LLM_MODEL=
AGM_KNOWLEDGE_SEARCH_MODE=hybrid
# Local: caminho absoluto para .venv/bin/bm; Docker: /app/.venv/bin/bm
AGM_MCP_EXECUTABLE=
AGM_TURN_TIMEOUT_MS=90000
